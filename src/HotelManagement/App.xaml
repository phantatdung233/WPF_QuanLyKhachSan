<Application x:Class="HotelManagement.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:HotelManagement.ViewModels"
             xmlns:views="clr-namespace:HotelManagement.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Canonical 8 ViewModel-to-View DataTemplates (#58) -->
            <DataTemplate DataType="{x:Type vm:RoomMapViewModel}">
                <views:RoomMapView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BookingViewModel}">
                <views:BookingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RoomViewModel}">
                <views:RoomView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RoomTypeViewModel}">
                <views:RoomTypeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomerViewModel}">
                <views:CustomerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ServiceViewModel}">
                <views:ServiceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InvoiceViewModel}">
                <views:InvoiceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportViewModel}">
                <views:ReportView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
