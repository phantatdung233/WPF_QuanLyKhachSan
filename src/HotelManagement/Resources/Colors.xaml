<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- Windows UI Kit Light Neutral Surfaces (Figma 01-Styles · 173024:781)      -->
    <!-- ========================================================================= -->
    <Color x:Key="AppSurfaceColor">#FFF3F3F3</Color>
    <Color x:Key="CardSurfaceColor">#B3FFFFFF</Color>
    <Color x:Key="CardSolidSurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="CardSecondarySurfaceColor">#FFF6F6F6</Color>
    <Color x:Key="FlyoutSurfaceColor">#FFF9F9F9</Color>

    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="CardSolidSurfaceBrush" Color="{StaticResource CardSolidSurfaceColor}" />
    <SolidColorBrush x:Key="CardSecondarySurfaceBrush" Color="{StaticResource CardSecondarySurfaceColor}" />
    <SolidColorBrush x:Key="FlyoutSurfaceBrush" Color="{StaticResource FlyoutSurfaceColor}" />

    <!-- Subtle interaction fills (Side Nav active/hover rgba(0,0,0,0.04)) -->
    <SolidColorBrush x:Key="SubtleTransparentBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="SubtleSecondaryBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="SubtleTertiaryBrush" Color="#06000000" />

    <!-- Control fills -->
    <SolidColorBrush x:Key="ControlFillDefaultBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="ControlFillSecondaryBrush" Color="#80F9F9F9" />
    <SolidColorBrush x:Key="ControlFillTertiaryBrush" Color="#4DF9F9F9" />
    <SolidColorBrush x:Key="ControlFillInputActiveBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#4DF9F9F9" />

    <!-- ========================================================================= -->
    <!-- Neutral Typography Foregrounds                                            -->
    <!-- ========================================================================= -->
    <Color x:Key="TextPrimaryColor">#E6000000</Color>
    <Color x:Key="TextSecondaryColor">#9C000000</Color>
    <Color x:Key="TextDisabledColor">#5C000000</Color>
    <Color x:Key="TextOnAccentPrimaryColor">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="TextOnAccentPrimaryBrush" Color="{StaticResource TextOnAccentPrimaryColor}" />

    <!-- ========================================================================= -->
    <!-- Neutral Strokes & Dividers                                                -->
    <!-- ========================================================================= -->
    <Color x:Key="CardStrokeColor">#0F000000</Color>
    <Color x:Key="ControlStrongStrokeColor">#9C000000</Color>
    <Color x:Key="DividerStrokeColor">#14000000</Color>
    <Color x:Key="SurfaceStrokeDefaultColor">#FF757575</Color>

    <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStrokeColor}" />
    <SolidColorBrush x:Key="ControlStrokeDefaultBrush" Color="{StaticResource CardStrokeColor}" />
    <SolidColorBrush x:Key="ControlStrongStrokeBrush" Color="{StaticResource ControlStrongStrokeColor}" />
    <SolidColorBrush x:Key="DividerStrokeBrush" Color="{StaticResource DividerStrokeColor}" />
    <SolidColorBrush x:Key="SurfaceStrokeDefaultBrush" Color="{StaticResource SurfaceStrokeDefaultColor}" />

    <!-- ========================================================================= -->
    <!-- Windows Accent (#005FB8 — Primary button & Side Nav selector)             -->
    <!-- ========================================================================= -->
    <Color x:Key="AccentColor">#FF005FB8</Color>
    <Color x:Key="AccentHoverColor">#E6005FB8</Color>
    <Color x:Key="AccentPressedColor">#CC005FB8</Color>
    <Color x:Key="AccentDisabledColor">#37000000</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="{StaticResource AccentDisabledColor}" />

    <!-- ========================================================================= -->
    <!-- Fixed Business RoomStatus Palette (DESIGN-BRIEF.md 2.4 — DO NOT ALTER)    -->
    <!-- ========================================================================= -->
    <Color x:Key="RoomAvailableColor">#FF48BB78</Color>
    <Color x:Key="RoomOccupiedColor">#FFF56565</Color>
    <Color x:Key="RoomReservedColor">#FFED8936</Color>
    <Color x:Key="RoomMaintenanceColor">#FFA0AEC0</Color>

    <SolidColorBrush x:Key="RoomAvailableBrush" Color="{StaticResource RoomAvailableColor}" />
    <SolidColorBrush x:Key="RoomOccupiedBrush" Color="{StaticResource RoomOccupiedColor}" />
    <SolidColorBrush x:Key="RoomReservedBrush" Color="{StaticResource RoomReservedColor}" />
    <SolidColorBrush x:Key="RoomMaintenanceBrush" Color="{StaticResource RoomMaintenanceColor}" />

    <!-- ========================================================================= -->
    <!-- Windows UI Kit Semantic System Colors (InfoBar, Toast & Inline Validation)-->
    <!-- ========================================================================= -->
    <Color x:Key="SystemSuccessColor">#FF0F7B0F</Color>
    <Color x:Key="SystemSuccessBackgroundColor">#FFDFF6DD</Color>
    <Color x:Key="SystemCautionColor">#FF9D5D00</Color>
    <Color x:Key="SystemCautionBackgroundColor">#FFFFF4CE</Color>
    <Color x:Key="SystemCriticalColor">#FFC42B1C</Color>
    <Color x:Key="SystemCriticalBackgroundColor">#FFFDE7E9</Color>
    <Color x:Key="SystemAttentionColor">#FF005FB7</Color>

    <SolidColorBrush x:Key="SystemSuccessBrush" Color="{StaticResource SystemSuccessColor}" />
    <SolidColorBrush x:Key="SystemSuccessBackgroundBrush" Color="{StaticResource SystemSuccessBackgroundColor}" />
    <SolidColorBrush x:Key="SystemCautionBrush" Color="{StaticResource SystemCautionColor}" />
    <SolidColorBrush x:Key="SystemCautionBackgroundBrush" Color="{StaticResource SystemCautionBackgroundColor}" />
    <SolidColorBrush x:Key="SystemCriticalBrush" Color="{StaticResource SystemCriticalColor}" />
    <SolidColorBrush x:Key="SystemCriticalBackgroundBrush" Color="{StaticResource SystemCriticalBackgroundColor}" />
    <SolidColorBrush x:Key="SystemAttentionBrush" Color="{StaticResource SystemAttentionColor}" />

</ResourceDictionary>
