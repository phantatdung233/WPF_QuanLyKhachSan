<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:views="clr-namespace:HotelManagement.Views">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <views:NavigationSymbolConverter x:Key="NavigationSymbolConverter" />

    <!-- Font Families (DESIGN.md) -->
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, Consolas</FontFamily>

    <!-- Corner Radius Geometry (DESIGN.md) -->
    <CornerRadius x:Key="CornerRadiusNone">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXs">2</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSm">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMd">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLg">12</CornerRadius>

    <!-- Typography Scale (DESIGN.md: natural DirectWrite vertical metrics for Vietnamese diacritics) -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="KpiValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="BodyStrongTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="CaptionStrongTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="InlineErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource InlineErrorTextBrush}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MonospaceReceiptTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonospaceFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Shared 4-State Feedback Primitives (DESIGN.md) -->
    <Style x:Key="LoadingProgressRingStyle" TargetType="ui:ProgressRing">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style x:Key="StatusInfoBarStyle" TargetType="ui:InfoBar">
        <Setter Property="IsClosable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- Layer 2 Elevated Card Containers over Layer 1 Workspace Sheet -->
    <Style x:Key="CardSurfaceBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMd}" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="ToolbarCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMd}" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <Style x:Key="CompactCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMd}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="EmptyStateCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMd}" />
        <Setter Property="Padding" Value="32" />
        <Setter Property="MaxWidth" Value="440" />
    </Style>

    <Style x:Key="HairlineDividerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardStrokeBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusNone}" />
    </Style>

    <Style x:Key="RoomStatusIndicatorBarStyle" TargetType="Border">
        <Setter Property="Width" Value="4" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusXs}" />
        <Setter Property="Background" Value="{StaticResource RoomAvailableBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Trống">
                <Setter Property="Background" Value="{StaticResource RoomAvailableBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Đang ở">
                <Setter Property="Background" Value="{StaticResource RoomOccupiedBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Đã đặt">
                <Setter Property="Background" Value="{StaticResource RoomReservedBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Bảo trì">
                <Setter Property="Background" Value="{StaticResource RoomMaintenanceBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Shared DataGrid Style (DESIGN.md: 40px scannable rows, horizontal hairline dividers) -->
    <Style x:Key="StandardDataGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="RowHeight" Value="40" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource CardStrokeBrush}" />
        <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}" />
        <Setter Property="RowBackground" Value="{StaticResource CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Shared 4-State Structured Card Template for Module Placeholders (DESIGN.md) -->
    <DataTemplate x:Key="PlaceholderModuleContentTemplate">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <ui:InfoBar Style="{StaticResource StatusInfoBarStyle}"
                            IsOpen="{Binding HasError, Mode=OneWay}"
                            Severity="Error"
                            Message="{Binding ErrorMessage}"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:InfoBar Style="{StaticResource StatusInfoBarStyle}"
                            IsOpen="{Binding HasSuccessMessage, Mode=OneWay}"
                            Severity="Success"
                            Message="{Binding SuccessMessage}"
                            Visibility="{Binding HasSuccessMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Border Style="{StaticResource CompactCardBorderStyle}"
                        Padding="32,24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:ProgressRing Style="{StaticResource LoadingProgressRingStyle}" />
                        <TextBlock Text="{Binding LoadingMessage}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EmptyStateCardBorderStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="48"
                                Height="48"
                                CornerRadius="{StaticResource CornerRadiusMd}"
                                Background="{StaticResource AccentTintBrush}"
                                HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="{Binding ModuleKey, Converter={StaticResource NavigationSymbolConverter}}"
                                           FontSize="24"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding EmptyStateTitle}"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   Margin="0,16,0,0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding EmptyStateSubtitle}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
