<ui:FluentWindow x:Class="HotelManagement.Views.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="AURA HOTEL — Đăng nhập hệ thống"
                 Width="460"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Default"
                 ExtendsContentIntoTitleBar="True"
                 Background="{StaticResource AppSurfaceBrush}"
                 Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Height="44"
                     Padding="12,0,0,0"
                     Title="AURA HOTEL — Đăng nhập hệ thống"
                     ShowMaximize="False"
                     CanMaximize="False" />

        <Border Grid.Row="1"
                Style="{StaticResource CardSurfaceBorderStyle}"
                Margin="24,8,24,24">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="40"
                            Height="40"
                            CornerRadius="{StaticResource CornerRadiusMd}"
                            Background="{StaticResource AccentTintBrush}"
                            BorderBrush="{StaticResource CardStrokeBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Building24"
                                       FontSize="20"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="AURA HOTEL"
                                   Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="Hệ thống quản lý khách sạn"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Nhập thông tin đăng nhập để mở không gian làm việc theo vai trò Quản trị hoặc Lễ tân."
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,16,0,16"
                           TextWrapping="Wrap" />

                <ui:InfoBar Style="{StaticResource StatusInfoBarStyle}"
                            IsOpen="{Binding HasError, Mode=OneWay}"
                            Severity="Error"
                            Message="{Binding ErrorMessage}"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <StackPanel>
                    <TextBlock Text="Tên đăng nhập"
                               Style="{StaticResource BodyStrongTextStyle}"
                               Margin="0,0,0,8" />
                    <ui:TextBox x:Name="UsernameInput"
                                Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Nhập tên đăng nhập"
                                Icon="{ui:SymbolIcon PersonAccounts24}"
                                ClearButtonEnabled="True"
                                IsEnabled="{Binding IsNotBusy}"
                                MinHeight="36"
                                Padding="12,8" />
                    <TextBlock Text="{Binding UsernameError}"
                               Style="{StaticResource InlineErrorTextStyle}"
                               Visibility="{Binding HasUsernameError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="Mật khẩu"
                               Style="{StaticResource BodyStrongTextStyle}"
                               Margin="0,0,0,8" />
                    <ui:PasswordBox x:Name="PasswordInput"
                                    PasswordChanged="OnPasswordInputPasswordChanged"
                                    PlaceholderText="Nhập mật khẩu"
                                    IsEnabled="{Binding IsNotBusy}"
                                    MinHeight="36"
                                    Padding="12,8" />
                    <TextBlock Text="{Binding PasswordError}"
                               Style="{StaticResource InlineErrorTextStyle}"
                               Visibility="{Binding HasPasswordError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <Border Background="{StaticResource SubtleSurfaceBrush}"
                        BorderBrush="{StaticResource CardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusSm}"
                        Padding="12"
                        Margin="0,16,0,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:ProgressRing Style="{StaticResource LoadingProgressRingStyle}" />
                        <TextBlock Text="{Binding LoadingMessage}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ui:Button Appearance="Primary"
                           IsDefault="True"
                           Command="{Binding LoginCommand}"
                           IsEnabled="{Binding IsNotBusy}"
                           Content="Đăng nhập"
                           HorizontalAlignment="Stretch"
                           MinHeight="36"
                           Padding="16,8"
                           Margin="0,20,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
