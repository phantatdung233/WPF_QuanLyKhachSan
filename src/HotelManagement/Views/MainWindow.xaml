<ui:FluentWindow x:Class="HotelManagement.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 ExtendsContentIntoTitleBar="True" Title="AURA HOTEL" Width="1280" Height="800" MinWidth="1280" MinHeight="720"
 WindowStartupLocation="CenterScreen" Background="{StaticResource AppSurfaceBrush}"
 FontFamily="{StaticResource AppFontFamily}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="84"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <ui:TitleBar Grid.ColumnSpan="2" Title="AURA HOTEL" />
  <Image Grid.Row="1" Source="{StaticResource AuraLogoImage}" Width="200" Height="48"
         Margin="20,14,20,22" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
         AutomationProperties.Name="AURA HOTEL"/>
  <ui:NavigationView Grid.Row="2" x:Name="Sidebar" Margin="0,0,12,0"
   PaneDisplayMode="Left" OpenPaneLength="232" IsBackButtonVisible="Collapsed" IsPaneToggleVisible="False"/>
  <Grid Grid.Row="1" Grid.Column="1" Margin="16,18,24,24">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="232"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleTextStyle}" VerticalAlignment="Center"/>
   <ui:Button Grid.Column="1" Appearance="Transparent" Padding="8,0" Click="OpenAccountMenu"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
              ToolTip="{Binding SessionDisplay}" AutomationProperties.Name="{Binding SessionDisplay}"
              AutomationProperties.HelpText="Mở menu tài khoản">
    <ui:Button.ContextMenu><ContextMenu><MenuItem Header="Đăng xuất" Click="Logout"/></ContextMenu></ui:Button.ContextMenu>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
     <ui:SymbolIcon Symbol="Person24" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1"><TextBlock Text="{Binding FullName}" Style="{StaticResource BodyStrongTextStyle}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding RoleDisplay}" Style="{StaticResource CaptionTextStyle}"/></StackPanel>
     <ui:SymbolIcon Grid.Column="2" Symbol="ChevronDown20" VerticalAlignment="Center"/>
    </Grid>
   </ui:Button>
  </Grid>
  <Border Grid.Row="2" Grid.Column="1" Margin="0,0,24,24" Background="{StaticResource CardSurfaceBrush}" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8">
   <ContentControl Content="{Binding CurrentView}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </Border>
 </Grid>
</ui:FluentWindow>
