<ui:FluentWindow x:Class="HotelManagement.Views.RolePreviewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="AURA HOTEL — Chọn phiên xem trước"
                 Width="460"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Default"
                 ExtendsContentIntoTitleBar="True"
                 Background="{StaticResource AppSurfaceBrush}"
                 Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Height="44"
                     Padding="12,0,0,0"
                     Title="AURA HOTEL — Chọn phiên xem trước"
                     ShowMaximize="False"
                     CanMaximize="False" />

        <Border Grid.Row="1"
                Style="{StaticResource CardSurfaceBorderStyle}"
                Margin="24,8,24,24">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="40"
                            Height="40"
                            CornerRadius="{StaticResource CornerRadiusMd}"
                            Background="{StaticResource AccentTintBrush}"
                            BorderBrush="{StaticResource CardStrokeBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Building24"
                                       FontSize="20"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="AURA HOTEL"
                                   Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="Khung điều hướng phân quyền (bản xem trước)"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Chọn vai trò phiên làm việc để kiểm tra phân quyền điều hướng trước khi tích hợp đăng nhập SQL."
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,16,0,16"
                           TextWrapping="Wrap" />

                <Border Background="{StaticResource SubtleSurfaceBrush}"
                        BorderBrush="{StaticResource CardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusSm}"
                        Padding="12,8"
                        Margin="0,0,0,8">
                    <RadioButton GroupName="RolePreviewGroup"
                                 IsChecked="{Binding IsAdministratorSelected, Mode=TwoWay}"
                                 Content="Quản trị — Toàn quyền 8 mục điều hướng" />
                </Border>

                <Border Background="{StaticResource SubtleSurfaceBrush}"
                        BorderBrush="{StaticResource CardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusSm}"
                        Padding="12,8">
                    <RadioButton GroupName="RolePreviewGroup"
                                 IsChecked="{Binding IsStaffSelected, Mode=TwoWay}"
                                 Content="Lễ tân — 6 mục vận hành tiếp tân" />
                </Border>

                <Border Background="{StaticResource AccentTintBrush}"
                        BorderBrush="{StaticResource CardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusSm}"
                        Padding="12"
                        Margin="0,16,0,20">
                    <TextBlock Text="{Binding SelectedScopeDescription}"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <ui:Button Appearance="Primary"
                           IsDefault="True"
                           Command="{Binding EnterShellCommand}"
                           IsEnabled="{Binding IsNotLoading}"
                           Content="Mở khung ứng dụng"
                           HorizontalAlignment="Stretch"
                           MinHeight="36"
                           Padding="16,8" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
