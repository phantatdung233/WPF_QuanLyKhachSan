<ui:FluentWindow x:Class="HotelManagement.Views.RolePreviewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="AURA HOTEL — Chọn phiên xem trước"
                 Width="480"
                 Height="384"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{StaticResource AppSurfaceBrush}"
                 Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Height="48"
                     Title="AURA HOTEL — Chọn phiên xem trước"
                     ShowMaximize="False"
                     CanMaximize="False" />

        <Border Grid.Row="1"
                Style="{StaticResource CardSurfaceBorderStyle}"
                Margin="24,8,24,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="AURA HOTEL"
                               Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="Chọn vai trò phiên làm việc để kiểm tra phân quyền khung điều hướng (tạm thời trước khi tích hợp đăng nhập SQL)."
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <RadioButton GroupName="RolePreviewGroup"
                                 IsChecked="{Binding IsAdministratorSelected, Mode=TwoWay}"
                                 Content="Quản trị — Toàn quyền 8 mục điều hướng"
                                 Margin="0,0,0,8" />
                    <RadioButton GroupName="RolePreviewGroup"
                                 IsChecked="{Binding IsStaffSelected, Mode=TwoWay}"
                                 Content="Lễ tân — 6 mục vận hành tiếp tân" />
                </StackPanel>

                <Border Grid.Row="2"
                        Background="{StaticResource SubtleSurfaceBrush}"
                        BorderBrush="{StaticResource CardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusSm}"
                        Padding="12"
                        Margin="0,16,0,16"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding SelectedScopeDescription}"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <ui:Button Grid.Row="3"
                           Appearance="Primary"
                           IsDefault="True"
                           Command="{Binding EnterShellCommand}"
                           IsEnabled="{Binding IsNotLoading}"
                           Content="Mở khung ứng dụng"
                           HorizontalAlignment="Stretch"
                           Height="32"
                           Padding="12,4" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
