<ui:FluentWindow x:Class="HotelManagement.Views.RoomTypeDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding Title}"
                 Width="460"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Default"
                 ExtendsContentIntoTitleBar="True"
                 Background="{StaticResource AppSurfaceBrush}"
                 Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Height="44"
                     Padding="12,0,0,0"
                     Title="{Binding Title}"
                     ShowMaximize="False"
                     CanMaximize="False"
                     ShowMinimize="False" />

        <Border Grid.Row="1"
                Style="{StaticResource CardSurfaceBorderStyle}"
                Margin="24,8,24,24">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="40"
                            Height="40"
                            CornerRadius="{StaticResource CornerRadiusMd}"
                            Background="{StaticResource AccentTintBrush}"
                            BorderBrush="{StaticResource CardStrokeBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Tag24"
                                       FontSize="20"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="Thiết lập tên loại phòng và đơn giá cơ bản theo đêm"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>

                <ui:InfoBar Style="{StaticResource StatusInfoBarStyle}"
                            Margin="0,16,0,0"
                            IsOpen="{Binding HasError, Mode=OneWay}"
                            Severity="Error"
                            Message="{Binding ErrorMessage}"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="Tên loại phòng"
                               Style="{StaticResource BodyStrongTextStyle}"
                               Margin="0,0,0,8" />
                    <ui:TextBox x:Name="TypeNameInput"
                                Text="{Binding TypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Ví dụ: Đơn, Đôi, Gia đình, VIP"
                                Icon="{ui:SymbolIcon Tag24}"
                                MaxLength="100"
                                ClearButtonEnabled="True"
                                IsEnabled="{Binding IsNotSaving}"
                                MinHeight="36"
                                Padding="12,8" />
                    <TextBlock Text="{Binding TypeNameError}"
                               Style="{StaticResource InlineErrorTextStyle}"
                               Visibility="{Binding HasTypeNameError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="Đơn giá/đêm"
                               Style="{StaticResource BodyStrongTextStyle}"
                               Margin="0,0,0,8" />
                    <ui:TextBox x:Name="PricePerDayInput"
                                Text="{Binding PriceInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Ví dụ: 500.000"
                                Icon="{ui:SymbolIcon ReceiptMoney24}"
                                ClearButtonEnabled="True"
                                IsEnabled="{Binding IsNotSaving}"
                                MinHeight="36"
                                Padding="12,8" />
                    <TextBlock Text="{Binding PricePerDayError}"
                               Style="{StaticResource InlineErrorTextStyle}"
                               Visibility="{Binding HasPricePerDayError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <Border Background="{StaticResource SubtleSurfaceBrush}"
                        BorderBrush="{StaticResource CardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusSm}"
                        Padding="12"
                        Margin="0,16,0,0"
                        Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:ProgressRing Style="{StaticResource LoadingProgressRingStyle}" />
                        <TextBlock Text="Đang lưu thông tin loại phòng..."
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,24,0,0">
                    <ui:Button Appearance="Secondary"
                               IsCancel="True"
                               Command="{Binding CancelCommand}"
                               IsEnabled="{Binding IsNotSaving}"
                               Content="Hủy"
                               MinHeight="36"
                               Padding="16,8" />

                    <!-- Single Primary CTA on RoomTypeDialog -->
                    <ui:Button Appearance="Primary"
                               IsDefault="True"
                               Command="{Binding SaveCommand}"
                               IsEnabled="{Binding IsNotSaving}"
                               Content="{Binding SaveButtonText}"
                               MinHeight="36"
                               Padding="16,8"
                               Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
