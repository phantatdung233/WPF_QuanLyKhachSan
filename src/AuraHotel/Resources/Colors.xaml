<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Accent Tokens (DESIGN.md) -->
    <Color x:Key="PrimaryColor">#005FB8</Color>
    <Color x:Key="PrimaryHoverColor">#00529E</Color>
    <Color x:Key="PrimaryPressedColor">#004382</Color>
    <Color x:Key="PrimaryTintColor">#EBF3FC</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="{StaticResource PrimaryTintColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />

    <!-- Three-Tier Fluent 2 Neutral Surface Layering (DESIGN.md) -->
    <!-- Layer 0: Base Window & Navigation Rail (#F3F3F3 + Mica) -->
    <!-- Layer 1: Workspace Content Sheet (#F9F9F9) -->
    <!-- Layer 2: Elevated Cards, Toolbars & DataGrids (#FFFFFF) -->
    <Color x:Key="NeutralColor">#F3F3F3</Color>
    <Color x:Key="AppSurfaceColor">#F3F3F3</Color>
    <Color x:Key="WorkspaceSurfaceColor">#F9F9F9</Color>
    <Color x:Key="CardSurfaceColor">#FFFFFF</Color>
    <Color x:Key="SubtleSurfaceColor">#F3F3F3</Color>
    <Color x:Key="HoverSurfaceColor">#EAEAEA</Color>
    <Color x:Key="FlyoutSurfaceColor">#FCFCFC</Color>
    <Color x:Key="CardStrokeColor">#E5E5E5</Color>

    <SolidColorBrush x:Key="NeutralBrush" Color="{StaticResource NeutralColor}" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
    <SolidColorBrush x:Key="WorkspaceSurfaceBrush" Color="{StaticResource WorkspaceSurfaceColor}" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="{StaticResource SubtleSurfaceColor}" />
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="{StaticResource HoverSurfaceColor}" />
    <SolidColorBrush x:Key="FlyoutSurfaceBrush" Color="{StaticResource FlyoutSurfaceColor}" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStrokeColor}" />

    <!-- Synchronize WPF-UI 4.3 Theme Resource Keys with DESIGN.md -->
    <Color x:Key="ApplicationBackgroundColor">#F3F3F3</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource AppSurfaceColor}" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource WorkspaceSurfaceColor}" />
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{StaticResource CardStrokeColor}" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{StaticResource HoverSurfaceColor}" />

    <Color x:Key="SystemAccentColor">#005FB8</Color>
    <Color x:Key="SystemAccentColorPrimary">#005FB8</Color>
    <Color x:Key="SystemAccentColorSecondary">#00529E</Color>
    <Color x:Key="SystemAccentColorTertiary">#004382</Color>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource PrimaryPressedColor}" />

    <!-- Typography Brushes (DESIGN.md) -->
    <Color x:Key="TextPrimaryColor">#1A1A1A</Color>
    <Color x:Key="TextSecondaryColor">#5C5C5C</Color>
    <Color x:Key="TextTertiaryColor">#757575</Color>
    <Color x:Key="DisabledTextColor">#595959</Color>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />

    <!-- Semantic Feedback Tokens (DESIGN.md) -->
    <Color x:Key="SystemSuccessColor">#0F7B0F</Color>
    <Color x:Key="SystemSuccessSurfaceColor">#DFF6DD</Color>
    <Color x:Key="SystemCautionColor">#8A5000</Color>
    <Color x:Key="SystemCautionSurfaceColor">#FFF4CE</Color>
    <Color x:Key="SystemCriticalColor">#C42B1C</Color>
    <Color x:Key="InlineErrorTextColor">#A42618</Color>
    <Color x:Key="SystemCriticalSurfaceColor">#FDE7E9</Color>

    <SolidColorBrush x:Key="SystemSuccessBrush" Color="{StaticResource SystemSuccessColor}" />
    <SolidColorBrush x:Key="SystemSuccessSurfaceBrush" Color="{StaticResource SystemSuccessSurfaceColor}" />
    <SolidColorBrush x:Key="SystemCautionBrush" Color="{StaticResource SystemCautionColor}" />
    <SolidColorBrush x:Key="SystemCautionSurfaceBrush" Color="{StaticResource SystemCautionSurfaceColor}" />
    <SolidColorBrush x:Key="SystemCriticalBrush" Color="{StaticResource SystemCriticalColor}" />
    <SolidColorBrush x:Key="InlineErrorTextBrush" Color="{StaticResource InlineErrorTextColor}" />
    <SolidColorBrush x:Key="SystemCriticalSurfaceBrush" Color="{StaticResource SystemCriticalSurfaceColor}" />

    <!-- Immutable Domain RoomStatus Indicators & Soft Badge Tints (DESIGN.md & GLOSSARY.md) -->
    <Color x:Key="RoomAvailableColor">#48BB78</Color>
    <Color x:Key="RoomAvailableTintColor">#EDFDF3</Color>
    <Color x:Key="RoomOccupiedColor">#F56565</Color>
    <Color x:Key="RoomOccupiedTintColor">#FFF5F5</Color>
    <Color x:Key="RoomReservedColor">#ED8936</Color>
    <Color x:Key="RoomReservedTintColor">#FFFAF0</Color>
    <Color x:Key="RoomMaintenanceColor">#A0AEC0</Color>
    <Color x:Key="RoomMaintenanceTintColor">#F7FAFC</Color>

    <SolidColorBrush x:Key="RoomAvailableBrush" Color="{StaticResource RoomAvailableColor}" />
    <SolidColorBrush x:Key="RoomAvailableTintBrush" Color="{StaticResource RoomAvailableTintColor}" />
    <SolidColorBrush x:Key="RoomOccupiedBrush" Color="{StaticResource RoomOccupiedColor}" />
    <SolidColorBrush x:Key="RoomOccupiedTintBrush" Color="{StaticResource RoomOccupiedTintColor}" />
    <SolidColorBrush x:Key="RoomReservedBrush" Color="{StaticResource RoomReservedColor}" />
    <SolidColorBrush x:Key="RoomReservedTintBrush" Color="{StaticResource RoomReservedTintColor}" />
    <SolidColorBrush x:Key="RoomMaintenanceBrush" Color="{StaticResource RoomMaintenanceColor}" />
    <SolidColorBrush x:Key="RoomMaintenanceTintBrush" Color="{StaticResource RoomMaintenanceTintColor}" />

</ResourceDictionary>
