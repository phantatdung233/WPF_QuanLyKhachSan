<UserControl x:Class="AuraHotel.Views.RoomTypeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Non-blocking Status Feedback Banners -->
        <StackPanel Grid.Row="0">
            <ui:InfoBar Style="{StaticResource StatusInfoBarStyle}"
                        IsOpen="{Binding HasError, Mode=OneWay}"
                        Severity="Error"
                        Message="{Binding ErrorMessage}"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ui:InfoBar Style="{StaticResource StatusInfoBarStyle}"
                        IsOpen="{Binding HasSuccessMessage, Mode=OneWay}"
                        Severity="Success"
                        Message="{Binding SuccessMessage}"
                        Visibility="{Binding HasSuccessMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <!-- Row 1: Search & Primary CTA Toolbar Card (Layer 2 CardSurfaceBrush) -->
        <Border Grid.Row="1"
                Style="{StaticResource ToolbarCardBorderStyle}"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox x:Name="SearchInput"
                            Grid.Column="0"
                            Width="320"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Tìm theo mã loại hoặc tên loại phòng..."
                            Icon="{ui:SymbolIcon Search24}"
                            ClearButtonEnabled="True"
                            IsEnabled="{Binding IsNotBusy}"
                            MinHeight="36"
                            Padding="12,8" />

                <!-- Single Primary CTA on RoomTypeView -->
                <ui:Button Grid.Column="1"
                           Appearance="Primary"
                           Command="{Binding OpenCreateDialogCommand}"
                           Icon="{ui:SymbolIcon Add24}"
                           Content="Thêm loại phòng"
                           MinHeight="36"
                           Padding="16,8"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Row 2: Mutually Exclusive Data Card / Loading Card / EmptyStateCard on Layer 1 Workspace Sheet -->
        <Grid Grid.Row="2">
            <!-- Success State: 40px Tabular DataGrid inside Layer 2 CardSurfaceBrush -->
            <Border Style="{StaticResource CardSurfaceBorderStyle}"
                    Padding="0"
                    ClipToBounds="True"
                    Visibility="{Binding IsTableVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DataGrid x:Name="RoomTypesDataGrid"
                          ItemsSource="{Binding FilteredRoomTypes}"
                          Style="{StaticResource StandardDataGridStyle}"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Mã loại" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RoomTypeId}"
                                               Style="{StaticResource BodyTextStyle}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Tên loại phòng" Width="*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TypeName}"
                                               Style="{StaticResource BodyTextStyle}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Đơn giá/đêm"
                                                Width="180"
                                                HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PricePerDayDisplay}"
                                               Style="{StaticResource BodyStrongTextStyle}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Số phòng" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RoomCount}"
                                               Style="{StaticResource BodyTextStyle}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Thao tác" Width="208">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <ui:Button Appearance="Secondary"
                                                   Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Icon="{ui:SymbolIcon Edit24}"
                                                   Content="Sửa"
                                                   MinHeight="36"
                                                   Padding="12,4" />

                                        <ui:Button Appearance="Danger"
                                                   Command="{Binding DataContext.DeleteRoomTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   IsEnabled="{Binding CanDelete}"
                                                   ToolTip="{Binding DeleteToolTip}"
                                                   ToolTipService.ShowOnDisabled="True"
                                                   Icon="{ui:SymbolIcon Delete24}"
                                                   Content="Xóa"
                                                   MinHeight="36"
                                                   Padding="12,4"
                                                   Margin="8,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Loading State: Centered Layer 2 Card on Layer 1 Workspace Sheet -->
            <Border Style="{StaticResource CompactCardBorderStyle}"
                    Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <ui:ProgressRing Style="{StaticResource LoadingProgressRingStyle}" />
                    <TextBlock Text="{Binding LoadingMessage}"
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Empty State: Centered EmptyStateCard (CardSurfaceBrush + 1px border) on Layer 1 Workspace Sheet -->
            <Border Style="{StaticResource EmptyStateCardBorderStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="48"
                            Height="48"
                            CornerRadius="{StaticResource CornerRadiusMd}"
                            Background="{StaticResource AccentTintBrush}"
                            HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Tag24"
                                       FontSize="24"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding EmptyStateTitle}"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,16,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding EmptyStateSubtitle}"
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,8,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <ui:Button Appearance="Secondary"
                               Command="{Binding ClearSearchCommand}"
                               Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                               Content="Xóa tìm kiếm"
                               MinHeight="36"
                               Padding="16,8"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Center"
                               Visibility="{Binding HasActiveSearch, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 3: Footer Summary & Safe-Delete Lock Hint -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding FooterSummaryText}"
                       Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="1"
                       Text="Chỉ cho phép xóa loại phòng chưa có phòng trực thuộc (Số phòng = 0)."
                       Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
